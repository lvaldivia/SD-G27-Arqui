{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {"analytics": false},
  "projects": {
    "frontend": {
      "projectType": "application", "root": "", "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"], "outputPath": "dist/frontend", "baseHref": "/"
          },
          "configurations": {
            "production": {"outputHashing": "all", "budgets": [{"type": "initial", "maximumWarning": "750kB", "maximumError": "1MB"}]},
            "development": {"optimization": false, "sourceMap": true}
          },
          "defaultConfiguration": "production"
        },
        "serve": {"builder": "@angular/build:dev-server", "configurations": {
          "development": {"buildTarget": "frontend:build:development"}
        }, "defaultConfiguration": "development"}
      }
    }
  }
}
