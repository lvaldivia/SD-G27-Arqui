# Copiar a .env en la raíz. No agregar comillas: Docker lee el valor literalmente.
DB_ENGINE=mysql
DB_HOST=REEMPLAZAR_ENDPOINT_RDS
DB_READ_HOST=
DB_PORT=3306
DB_NAME=curso_productos
DB_USER=administrador
DB_PASSWORD=REEMPLAZAR_CONTRASENA
AWS_REGION=us-east-1
DYNAMO_TABLE=productos
DYNAMO_AUTO_CREATE=false
DYNAMO_ENDPOINT=
# Orígenes que pueden llamar a la API desde el navegador, separados por comas. * = cualquiera.
CORS_ORIGINS=*
